{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "otaome",
	"main": "src/index.js",
	"compatibility_date": "2026-10-29",
	"observability": {
		"enabled": true,
		"traces": {
			"enabled": true
		}
	},
	"upload_source_maps": true,
	"kv_namespaces": [
		{
			"binding": "HPBD_THUY",
			"id": "ce0b9829683d42c9bdf81308e20f37fc"
		}
	]
}
